NODE_ENV=

# 소셜 로그인 (카카오)
NEXT_PUBLIC_KAKAO_CLIENT_ID=

NEXT_PUBLIC_BACKEND_API_URL=

# E2E 테스트 계정
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_TEST_STUDENT_NAME=
E2E_TEST_STUDY_ROOM_ID=

# Sentry
NEXT_PUBLIC_GLITCHTIP_DSN=

# Amplitude
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# MVP-H(오독공) 조각 1 기능 플래그. 'on' 일 때만 새 화면 진입점과 새 URL 이 열린다.
# 빌드 때 값이 박힌다(서버와 브라우저가 같은 값이어야 한다: 한쪽만 주면 하이드레이션 오류).
# 개발(dev/preview) 빌드에만 on 을 넣고, 운영 빌드에는 넣지 않는다(비워 둔다).
NEXT_PUBLIC_MVPH_SLICE1=
