{
  "name": "the-edu-front",
  "version": "2.0.18",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "https": "next dev -H app.dev.the-edu.site -p 3000 --experimental-https",
    "debug": "node --inspect node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "lint:fix": "eslint src --fix && npm run format",
    "lint:strict": "eslint --max-warnings=0 src",
    "format": "prettier --write */**/*.{js,jsx,json,ts,tsx,scss,css,md}",
    "format:check": "prettier -c */**/*.{js,jsx,json,ts,tsx,scss,css,md}",
    "test": "vitest",
    "test:ci": "node scripts/check-design-tokens.mjs && vitest run",
    "prepare": "cd .. && husky mvp-front/.husky",
    "check-types": "tsc --noEmit",
    "check-types:watch": "tsc --noEmit --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check-design": "node scripts/check-design-tokens.mjs"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.39.0",
